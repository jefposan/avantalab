# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Supabase temp
supabase/.temp/
# Rascunhos deliberadamente não aplicados não pertencem ao sistema oficial.
supabase/drafts/

# Snapshots locais de dados reais antes de migrations; nunca versionar.
.backups/
backups/

# Worktrees e estado local do Codex.
.codex/

# Referência local preservada da reconstrução do AvantaVendas
/app/avantavendas/documentacao/referencia_tridium/
